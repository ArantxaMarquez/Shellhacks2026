# Copy this file to .env (same folder) and fill it in.
# .env is git-ignored; never commit real credentials.

# Who gets called: three E.164 numbers, comma-separated, no spaces needed.
RETELL_TEAM_NUMBERS=+15551110001,+15551110002,+15551110003

# Primary channel: Retell voice agent
RETELL_ENABLED=true
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=+15551234567

# Fallback (only used when RETELL_ENABLED=false): plain Twilio voice call to the same team numbers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15557654321
